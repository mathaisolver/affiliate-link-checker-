# === Supabase (REQUIRED) ===
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here  # KEEP THIS SECRET — server only!

# === Public Site URL ===
NEXT_PUBLIC_SITE_URL=https://affiliate-link-checker.vercel.app

# === Gumroad (for $9 lifetime Pro upgrade) ===
# Create a product at gumroad.com, then paste the product URL here.
GUMROAD_PRODUCT_URL=https://gumroad.com/l/your-product-slug
# After creating a webhook in Gumroad, paste the secret here.
GUMROAD_WEBHOOK_SECRET=your-webhook-secret-here

# === Optional: Local SQLite DB (only needed if you use Prisma features) ===
DATABASE_URL=file:/home/z/my-project/db/custom.db
